{
  "description": "vault-mcp connectivity (SessionStart health warning) + record-class write guard (PreToolUse on Bash and mcp__(vault-mcp|governor)__* \u2014 refuses non-append writes under 'Machinery record/').",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/vault-mcp-health.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/block-record-writes.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(vault-mcp|governor)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/block-record-writes.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
